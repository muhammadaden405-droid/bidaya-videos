{"id":"jazariyya","secs":["","","","","","","","","","","","","","","","","","","","","","","","","","","",""],"L":[[0,0,["يقول راجي عفو رب سامع","محمد بن الجزري الشافعي"]],[0,1,["الحمد لله وصلى الله","على نبيه ومصطفاه"]],[0,2,["محمد وآله وصحبه","ومقرئ القرآن مع محبه"]],[0,3,["وبعد إن هذه مقدمه","فيما على قارئه أن يعلمه"]],[1,4,["إذ واجب عليهم محتم","قبل الشروع أولا أن يعلموا"]],[1,5,["مخارج الحروف والصفات","ليلفظوا بأفصح اللغات"]],[1,6,["محرري التجويد والمواقف","وما الذي رسم في المصاحف"]],[1,7,["من كل مقطوع وموصول بها","وتاء أنثى لم تكن تكتب بتا"]],[2,8,["مخارج الحروف سبعة عشر","على الذي يختاره من اختبر"]],[2,9,["فألف الجوف وأختاها","وهي حروف مد للهواء تنتهي"]],[2,10,["ثم لأقصى الحلق همز هاء","ثم لوسطه فعين حاء"]],[2,11,["أدناه غين خاؤها والقاف","أقصى اللسان فوق ثم الكاف"]],[3,12,["أسفل والوسط فجيم الشين يا","والضاد من حافته إذ وليا"]],[3,13,["لاضراس من أيسر أو يمناها","واللام أدناها لمنتهاها"]],[3,14,["والنون من طرفه تحت اجعلوا","والرا يدانيه لظهر أدخل"]],[3,15,["والطاء والدال وتا منه ومن","عليا الثناياو الصفير مستكن"]],[4,16,["منه ومن فوق الثنايا السفلى","والظاء والذال وثا للعليا"]],[4,17,["من طرفيهما ومن بطن الشفه","فالفا مع اطراف الثنايا المشرفه"]],[4,18,["للشفتين الواو باء ميم","وغنة مخرجها الخيشوم"]],[4,19,["صفاتها جهر ورخو مستفل","منفتح مصمتة والضد قل"]],[5,20,["مهموسها \"فحثه شخص سكت\"","شديدها لفظ \"أجد قط بكت\""]],[5,21,["وبين رخو والشديد \"لن عمر\"","وسبع علو \"خص ضغط قظ\" حصر"]],[5,22,["وصاد ضاد طاء ظاء مطبقه","و\"فر من لب\" الحروف المذلقه"]],[5,23,["صفيرها صاد وزاي سين","قلقلة \"قطب جد \"واللين"]],[6,24,["واو وياء سكنا وانفتحا","قبلهما والانحراف صححا"]],[6,25,["في اللام والرا وبتكرير جعل","وللتفشي الشين ضادا استطل"]],[6,26,["والأخذ بالتجويد حتم لازم","من لم يجود القرآن آثم"]],[6,27,["لأنه به الإله أنزلا","وهكذا منه إلينا وصلا"]],[7,28,["وهو أيضا حلية التلاوة","وزينة الأداء والقراءة"]],[7,29,["وهو إعطاء الحروف حقها","من صفة لها ومستحقها"]],[7,30,["ورد كل واحد لأصله","واللفظ في نظيره كمثله"]],[7,31,["مكملا من غير ما تكلف","باللطف في النطق بلا تعسف"]],[8,32,["وليس بينه وبين تركه","إلارياضة امرئ بفكه"]],[8,33,["فرققن مستفلا من أحرف","وحاذرن تفخيم لفظ الألف"]],[8,34,["وهمز ألحمد أعوذ إهدنا","ألله ثم لام لله لنا"]],[8,35,["وليتلطف وعلى الله ولا الض","والميم من مخمصة ومن مرض"]],[9,36,["وباء برق باطل بهم بذي","فاحرص على الشدة والجهر الذي"]],[9,37,["فيها وفي الجيم كحب الصبر","ربوة اجتثت وحج الفجر"]],[9,38,["وبينن مقلقلا إن سكنا","وإن يكن في الوقف كان أبينا"]],[9,39,["وحاء حصحص أحطت الحق","وسين مستقيم يسطوا يسقوا"]],[10,40,["ورقق الراء إذا ما كسرت","كذاك بعد الكسر حيث سكنت"]],[10,41,["إن لم تكن من قبل حرف استعلا","أو كانت الكسرة ليست أصلا"]],[10,42,["والخلف في فرق لكسر يوجد","وأخف تكريرا إذا تشدد"]],[10,43,["وفخم اللام من اسم الله","عن فتح اوضم كعبد الله"]],[11,44,["وحرف الاستعلاء فخم واخصصا","الاطباق أقوى نحو قال والعصا"]],[11,45,["وبين الإطباق من أحطت مع","بسطت والخلف بنخلقكم وقع"]],[11,46,["واحرص على السكون في جعلنا","أنعمت والمغضوب مع ضللنا"]],[11,47,["وخلص انفتاح محذورا عسى","خوف اشتباهه بمحظورا عصى"]],[12,48,["وراع شدة بكاف وبتا","كشرككم وتتوفى فتنتا"]],[12,49,["وأولى مثل وجنس إن سكن","أدغم كقل رب وبل لا وأبن"]],[12,50,["في يوم مع قالوا وهم وقل نعم","سبحه لا تزغ قلوب فالتقم"]],[12,51,["والضاد باستطالة ومخرج","ميز من الظاء وكلها تجي"]],[13,52,["في الظعن ظل الظهر عظم الحفظ","أيقظ وأنظر عظم ظهر اللفظ"]],[13,53,["ظاهر لظى شواظ كظم ظلما","اغلظ ظلام ظفر انتظر ظما"]],[13,54,["أظفر ظنا كيف جا وعظ سوى","عضين ظل النحل زخرف سوا"]],[13,55,["فظلت ظلتم وبروم ظلوا","كالحجر ظلت شعرا نظل"]],[14,56,["يظللن محظورا مع المحتظر","وكنت فظا وجميع النظر"]],[14,57,["إلا بويل وهل وأولى ناضره","والغيظ لا الرعد وهود قاصره"]],[14,58,["والحظ لا الحض على الطعام","وفي ضنين الخلاف سامي"]],[14,59,["وإن تلاقيا البيان لازم","أنقض ظهرك يعض الظالم"]],[15,60,["واضطر مع وعظت مع أفضتم","وصف ها جباههم عليهم"]],[15,61,["وأظهر الغنة من نون ومن","ميم إذا ما شددا وأخفين"]],[15,62,["الميم إن تسكن بغنة عند الباء","على المختار من أهل الأداء"]],[15,63,["وأظهرنها عند باقي الأحرف","واحذر لدى واو وفا أن تختفي"]],[16,64,["وحكم تنوين ونون يلفى","إظهار ادغام وقلب اخفا"]],[16,65,["فعند حرف الحلق أظهر وادغم","في اللام والرا لا بغنة لزم"]],[16,66,["وأدغمن بغنة في يومن","إلا بكلمة كدنيا عنونوا"]],[16,67,["والقلب عند البا بغنة كذا","إخفا لدى باقي الحروف أخذا"]],[17,68,["والمد لازم وواجب أتى","وجائز وهو وقصر ثبتا"]],[17,69,["فلازم إن جاء بعد حرف مد","ساكن حالين وبالطول يمد"]],[17,70,["وواجب إن جاء قبل همزة","متصلا إن جمعا بكلمة"]],[17,71,["وجائز إذا أتى منفصلا","أو عرض السكون وقفا مسجلا"]],[18,72,["وبعد تجويدك للحروف","لا بد من معرفة الوقوف"]],[18,73,["والابتداء وهي تنقسم إذن","ثلاثة تام وكاف وحسن"]],[18,74,["وهي لما تم فإن لم يوجد","تعلق أوكان معنى فابتدي"]],[18,75,["فالتام فالكافي ولفظا فامنعن","إلا رؤوس الآي جوز فالحسن"]],[19,76,["وغير ما تم قبيح وله","يوقف مضطرا ويبدا قبله"]],[19,77,["وليس في القرآن من وقف وجب","ولا حرام غير ما له سبب"]],[19,78,["واعرف لمقطوع وموصول وتا","في مصحف الإمام فيما قد أتى"]],[19,79,["فاقطع بعشر كلمات أن لا","مع ملجإ ولا إله إلا"]],[20,80,["وتعبدوا ياسين ثاني هود لا","يشركن تشرك يدخلن تعلوا على"]],[20,81,["أن لا يقولوا لا إله إن ما","بالرعد كالمفتوح صل وعن ما"]],[20,82,["نهوا اقطعوا من ما بروم والنسا","خلف المنافقين أم من أسسا"]],[20,83,["فصلت النسا وذبح حيث ما","وأن لم المفتوح كسر إن ما"]],[21,84,["الانعام والمفتوح يدعون معا","وخلف الانفال ونحل وقعا"]],[21,85,["وكل ما سألتموه واختلف","ردوا كذا قل بئسما والوصل صف"]],[21,86,["خلفتموني واشتروا في ما اقطعا","أوحي أفضتم اشتهت يبلوا معا"]],[21,87,["ثاني فعلن وقعت روم كلا","تنزيل شعراء وغيرها صلا"]],[22,88,["فأينما كالنحل صل ومختلف","في الشعرا الأحزاب والنسا وصف"]],[22,89,["وصل فإلم هود ألن نجعلا","نجمع كيلا تحزنوا تأسوا على"]],[22,90,["حج عليك حرج وقطعهم","عن من يشاء من تولى يوم هم"]],[22,91,["ومال هذا والذين هؤلا","تحين في الإمام وصلا ووهلا"]],[23,92,["ووزنزهم كالوهم صل","كذا من أل ويا وها لا تفصل"]],[23,93,["ورحمتا الزخرف بالتا زبره","الاعراف روم هود كاف البقره"]],[23,94,["نعمتها ثلاث نحل إبرهم","معا أخيرات عقود الثان هم"]],[23,95,["لقمان ثم فاطر كالطور","عمران لعنت بها والنور"]],[24,96,["وامرأت يوسف عمران القصص","تحريم معصيت بقد سمع يخص"]],[24,97,["شجرت الدخان سنت فاطر","كلا والانفال وحرف غافر"]],[24,98,["قرت عين جنت في وقعت","فطرت بقيت وابنت وكلمت"]],[24,99,["أوسط الاعراف وكل مااختلف","جمعا وفردا فيه بالتاء عرف"]],[25,100,["وابدأ بهمز الوصل من فعل بضم","إن كان ثالث من الفعل يضم"]],[25,101,["واكسره حال الكسر والفتح وفى","الاسماء غير اللام كسرها وفي"]],[25,102,["ابن مع ابنة امرئ واثنين","وامرأة واسم مع اثنتين"]],[25,103,["وحاذر الوقف بكل الحركه","إلا إذا رمت فبعض حركه"]],[26,104,["إلا بفتح أو بنصب وأشم","إشارة بالضم في رفع وضم"]],[26,105,["وقد تقضى نظمي المقدمه","مني لقارئ القرآن تقدمة"]],[26,106,["أبياتها قاف وزاي بالعدد","من يحسن التجويد يظفر بالرشد"]],[26,107,["والحمد لله له ختام","ثم الصلاة بعد والسلام"]],[27,108,["على النبي المصطفى واله","وصحبه وتابعي منواله"]]]}