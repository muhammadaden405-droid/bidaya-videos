{"id":"tuhfa","secs":["","","","","","","","","","","","","","","",""],"L":[[0,0,["يقول راجي رحمة الغفور","دوما سليمان هو الجمزوري"]],[0,1,["الحمد لله مصليا على","محمد وآله ومن تلا"]],[0,2,["وبعد: هذا النظم للمريد","في النون والتنوين والمدود"]],[0,3,["سميته بتحفة الأطفال","عن شيخنا الميهى ذي الكمال"]],[1,4,["أرجو به أن ينفع الطلابا","والأجر والقبول والثوابا"]],[1,5,["للنون إن تسكن وللتنوين","أربع أحكام فخذ تبييني"]],[1,6,["فالأول الإظهار قبل أحرف","للحلق ست رتبت فلتعرف"]],[1,7,["همز فهاء ثم عين حاء","مهملتان ثم غين خاء"]],[2,8,["والثان إدغام بستة أتت","في يرملون عندهم قد ثبتت"]],[2,9,["لكنها قسمان قسم يدغما","فيه بغنة بينمو علما"]],[2,10,["إلا إذا كانا بكلمة فلا","تدغم كدنيا ثم صنوان تلا"]],[2,11,["والثان إدغام بغير غنه","في اللام والرا ثم كررنه"]],[3,12,["والثالث الإقلاب عند الباء","ميما بغنة مع الإخفاء"]],[3,13,["والرابع الإخفاء عند الفاضل","من الحروف واجب للفاضل"]],[3,14,["في خمسة من بعد عشر رمزها","في كلم هذا البيت قد ضمنتها"]],[3,15,["صف ذا ثنا كم جاد شخص قد سما","دم طيبا زد في تقى ضع ظالما"]],[4,16,["وغن ميما ثم نونا شددا","وسم كلا حرف غنة بدا"]],[4,17,["والميم إن تسكن تجي قبل الهجا","لا ألف لينة لذي الحجا"]],[4,18,["أحكامها ثلاثة لمن ضبط","إخفاء ادغام وإظهار فقط"]],[4,19,["فالأول الإخفاء عند الباء","وسمه الشفوي للقراء"]],[5,20,["والثان إدغام بمثلها أتى","وسم إدغاما صغيرا يا فتى"]],[5,21,["والثالث الإظهار في البقيه","من أحرف وسمها شفويه"]],[5,22,["واحذر لدى واو وفا أن تختفي","لقربها ولاتحاد فاعرف"]],[5,23,["للام أل حالان قبل الأحرف","أولاهما إظهارها فلتعرف"]],[6,24,["قبل اربع مع عشرة خذ علمه","من ابغ حجك وخف عقيمه"]],[6,25,["ثانيهما إدغامها في أربع","وعشرة أيضا ورمزها فع"]],[6,26,["طب ثم صل رحما تفز ضف ذا نعم","دع سوء ظن زر شريفا للكرم"]],[6,27,["واللام الاولى سمها قمريه","واللام الاخرى سمها شمسيه"]],[7,28,["وأظهرن لام فعل مطلقا","في نحو قل نعم وقلنا والتقى"]],[7,29,["إن في الصفات والمخارج اتفق","حرفان فالمثلان فيهما أحق"]],[7,30,["وإن يكونا مخرجا تقاربا","وفي الصفات اختلفا يلقبا"]],[7,31,["متقاربين أو يكونا اتفقا","في مخرج دون الصفات حققا"]],[8,32,["بالمتجانسين ثم إن سكن","أول كل فالصغير سمين"]],[8,33,["أو حرك الحرفان في كل فقل","كل كبير وافهمنه بالمثل"]],[8,34,["والمد أصلي وفرعي له","وسم أولا طبيعيا وهو"]],[8,35,["ما لا توقف له على سبب","ولا بدونه الحروف تجتلب"]],[9,36,["بل أي حرف غير همز أو سكون","جا بعد مد فالطبيعي يكون"]],[9,37,["والآخر الفرعي موقوف على","سبب كهمز أو سكون مسجلا"]],[9,38,["حروفه ثلاثة فعيها","من لفظ واي وهي في نوحيها"]],[9,39,["والكسر قبل اليا وقبل الواو ضم","شرط وفتح قبل ألف يلتزم"]],[10,40,["واللين منها اليا وواو سكنا","إن انفتاح قبل كل أعلنا"]],[10,41,["للمد أحكام ثلاثة تدوم","وهي الوجوب والجواز واللزوم"]],[10,42,["فواجب إن جاء همز بعد مد","في كلمة وذا بمتصل يعد"]],[10,43,["وجائز مد وقصر إن فصل","كل بكلمة وهذا المنفصل"]],[11,44,["ومثل ذا إن عرض السكون","وقفا كتعلمون نستعين"]],[11,45,["أو قدم الهمز على المد وذا","بدل كآمنوا وإيمانا خذا"]],[11,46,["ولازم إن السكون أصلا","وصلا ووقفا بعد مد طولا"]],[11,47,["أقسام لازم لديهم أربعه","وتلك كلمي وحرفي معه"]],[12,48,["كلاهما مخفف مثقل","فهذه أربعة تفصل"]],[12,49,["فإن بكلمة سكون اجتمع","مع حرف مد فهو كلمي وقع"]],[12,50,["أو في ثلاثي الحروف وجدا","والمد وسطه فحرفي بدا"]],[12,51,["كلاهما مثقل إن أدغما","مخفف كل إذا لم يدغما"]],[13,52,["واللازم الحرفي أول السور","وجوده وفي ثمان انحصر"]],[13,53,["يجمعها حروف كم عسل نقص","وعين ذو وجهين والطول أخص"]],[13,54,["وما سوى الحرف الثلاثي لا ألف","فمده مدا طبيعيا ألف"]],[13,55,["وذاك أيضا في فواتح السور","في لفظ حي طاهر قد انحصر"]],[14,56,["ويجمع الفواتح الأربع عشر","صله سحيرا من قطعك ذا اشتهر"]],[14,57,["وتم ذا النظم بحمد الله","على تمامه بلا تناهي"]],[14,58,["أبياته ند بدا لذ النهى","تاريخها بشرى لمن يتقنها"]],[14,59,["ثم الصلاة والسلام أبدا","على ختام الأنبياء أحمدا"]],[15,60,["والآل والصحب وكل تابع","وكل قارئ وكل سامع"]]]}