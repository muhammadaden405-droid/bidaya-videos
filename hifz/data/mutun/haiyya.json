{"id":"haiyya","secs":["","","","","","","","","",""],"L":[[0,0,["تمسك بحبل الله واتبع الهدى","ولا تك بدعيا لعلك تفلح"]],[0,1,["ودن بكتاب الله والسنن التي","أتت عن رسول الله تنجو وتربح"]],[0,2,["وقل غير مخلوق كلام مليكنا","بذلك دان الأتقياء وأفصحوا"]],[0,3,["ولا تك في القرآن بالوقف قائلا","كما قال أتباع لجهم وأسجحوا"]],[1,4,["ولا تقل القرآن خلق قرانه","فإن كلام الله باللفظ يوضح"]],[1,5,["وقل يتجلى الله للخلق جهرة","كما البدر لا يخفى وربك أوضح"]],[1,6,["وقد ينكر الجهمي هذا وعندنا","بمصداق ما قلنا حديث مصرح"]],[1,7,["رواه جرير عن مقال محمد","فقل مثل ما قد قال في ذاك تنجح"]],[2,8,["وقد ينكر الجهمي أيضا يمينه","وكلتا يديه بالفواضل تنفح"]],[2,9,["وقل ينزل الجبار في كل ليلة","بلا كيف جل الواحد المتمدح"]],[2,10,["إلى طبق الدنيا يمن بفضله","فتفرج أبواب السماء وتفتح"]],[2,11,["يقول ألا مستغفر يلق غافرا","ومستمنح خيرا ورزقا فيمنح"]],[3,12,["روى ذاك قوم لا يرد حديثهم","ألا خاب قوم كذبوهم وقبحوا"]],[3,13,["وقل إن خير الناس بعد محمد","وزيراه قدما ثم عثمان الأرجح"]],[3,14,["ورابعهم خير البرية بعدهم","علي حليف الخير بالخير منجح"]],[3,15,["وإنهم الرهط لا ريب فيهم","على نجب الفردوس في الخلد تسرح"]],[4,16,["سعيد وسعد وابن عوف وطلحة","وعامر فهر والزبير الممدح"]],[4,17,["وسبطي رسول الله وابني خديجة","وفاطمة ذات النقاء تبحبحوا"]],[4,18,["وعائشة أم المؤمنين وخالنا","معاوية أكرم به ثم امنح"]],[4,19,["وأنصاره والمهاجرون ديارهم","بنصرتهم عن كية النار زحزحوا"]],[5,20,["ومن بعدهم فالتابعون لحسن مآخذ","وأفعالهم قولا وفعلا فأفلحوا"]],[5,21,["ومالك والثوري ثم أخوهم","أبو عمرو الأوزاعي ذاك المسبح"]],[5,22,["ومن بعدهم فالشافعي وأحمد","إماما هدى من يتبع الحق ينصح"]],[5,23,["أولئك قوم قد عفا الله عنهم","فاحببهم فإنك تفرح"]],[6,24,["وقل خير قول في الصحابة كلهم","ولاتك طعانا تعيب وتجرح"]],[6,25,["فقد نطق الوحي المبين بفضلهم","وفي الفتح آي للصحابة تمدح"]],[6,26,["وبالقدر المقدور أيقن فإنه","دعامة عقد الدين والدين أفيح"]],[6,27,["ولا تنكرن جهلا نكيرا ومنكرا","ولا الحوض والميزان إنك تنصح"]],[7,28,["وقل يخرج الله العظيم بفضله","من النار أجسادا من الفحم تطرح"]],[7,29,["على النهر في الفردوس تحيى بمائه","كحبة حمل السيل إذا جاء يطفح"]],[7,30,["وإن رسول الله للخلق شافع","وقل في عذاب القبر حق موضح"]],[7,31,["ولا تكفرن أهل الصلاة وإن عصوا","فكلهم يعصى وذو العرش يصفح"]],[8,32,["ولا تعتقد رأي الخوارج إنه","مقال لمن يهواه يردي ويفضح"]],[8,33,["ولاتك مرجيا لعوبا بدينه","ألا إنما المرجي بالدين يمزح"]],[8,34,["وقل إنما الإيمان قول ونية","وفعل على قول النبي مصبح"]],[8,35,["وينقص طورا بالمعاصي وتارة","بطاعته ينمى وفي الوزن يرجح"]],[9,36,["ودع عنك آراء الرجال وقولهم","فقول رسول الله أزكى وأشرح"]],[9,37,["ولاتك من قوم تلهو بدينهم","فتطعن في أهل الحديث وتقدح"]],[9,38,["إذا ما اعتقدت الدهر يا صاح هذه","فأنت على خير تبيت وتصبح"]]]}